.git
.github
# Exclude object files from context (smaller uploads) but keep tracked GB
# prebuilts required by resources.qrc — qmake fails without them.
**/*.o
!resources/bin/gbt-player/gbt_player.o
!resources/bin/gbt-player/gbt_player_bank1.o
**/moc_*.cpp
**/ui_*.h
**/qrc_*.cpp
**/Makefile
**/.qmake.stash
# Doc/markdown churn shouldn't bust the expensive Qt make layer
# (the TRSE `builder` stage runs `COPY . .` over the full repo).
# docker/ stays in context — final stage explicitly copies
# stos2asc.class + entrypoint.sh from there.
docs/
retrodocs/
README.md
*.md
LICENSE.txt
*.icns
*.ico
